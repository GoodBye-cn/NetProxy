{
    "version": 3,
    "cmakeMinimumRequired": {
        "major": 4,
        "minor": 2,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "base",
            "hidden": true,
            "binaryDir": "${sourceDir}/build/${presetName}",
            "cacheVariables": {
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
            }
        },
        {
            "name": "linux-clang",
            "displayName": "Linux Clang Debug",
            "description": "Unix Makefiles + clang++，Debug 配置",
            "inherits": "base",
            "generator": "Unix Makefiles",
            "cacheVariables": {
                "CMAKE_CXX_COMPILER": "clang++",
                "CMAKE_BUILD_TYPE": "Debug"
            },
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Linux"
            }
        },
        {
            "name": "linux-clang-release",
            "displayName": "Linux Clang Release",
            "description": "Unix Makefiles + clang++，Release 配置",
            "inherits": "linux-clang",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        },
        {
            "name": "windows-msvc",
            "displayName": "Windows MSVC Debug",
            "description": "Visual Studio 2022 + MSVC，x64，Debug 配置",
            "inherits": "base",
            "generator": "Visual Studio 17 2022",
            "architecture": "x64",
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Windows"
            }
        },
        {
            "name": "windows-msvc-release",
            "displayName": "Windows MSVC Release",
            "description": "Visual Studio 2022 + MSVC，x64，Release 配置",
            "inherits": "windows-msvc"
        },
        {
            "name": "windows-vs2026",
            "displayName": "Windows MSVC (VS 2026) Debug",
            "description": "Visual Studio 18 2026 + MSVC，x64，Debug 配置",
            "inherits": "base",
            "generator": "Visual Studio 18 2026",
            "architecture": "x64",
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Windows"
            }
        },
        {
            "name": "windows-vs2026-release",
            "displayName": "Windows MSVC (VS 2026) Release",
            "description": "Visual Studio 18 2026 + MSVC，x64，Release 配置",
            "inherits": "windows-vs2026"
        },
        {
            "name": "android-base",
            "displayName": "Android 交叉编译基础配置",
            "description": "NDK 工具链 + Ninja，JNI 并入核心库，只产出一个 .so；不编译测试与 CLI",
            "hidden": true,
            "inherits": "base",
            "generator": "Ninja",
            "toolchainFile": "$env{ANDROID_NDK_HOME}/build/cmake/android.toolchain.cmake",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "ANDROID_PLATFORM": "android-24",
                "ANDROID_STL": "c++_shared",
                "ANDROID_SUPPORT_FLEXIBLE_PAGE_SIZES": "ON",
                "BUILD_SHARED_LIBS": "ON",
                "NETPROXY_BUILD_JNI": "ON",
                "NETPROXY_BUILD_TESTS": "OFF",
                "NETPROXY_BUILD_APPS": "OFF"
            }
        },
        {
            "name": "android-arm64-v8a",
            "displayName": "Android arm64-v8a",
            "description": "64 位 ARM，主流真机",
            "inherits": "android-base",
            "cacheVariables": {
                "ANDROID_ABI": "arm64-v8a"
            }
        },
        {
            "name": "android-armeabi-v7a",
            "displayName": "Android armeabi-v7a",
            "description": "32 位 ARM，老设备兼容",
            "inherits": "android-base",
            "cacheVariables": {
                "ANDROID_ABI": "armeabi-v7a"
            }
        },
        {
            "name": "android-x86_64",
            "displayName": "Android x86_64",
            "description": "x86_64 模拟器",
            "inherits": "android-base",
            "cacheVariables": {
                "ANDROID_ABI": "x86_64"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "linux-clang",
            "configurePreset": "linux-clang"
        },
        {
            "name": "linux-clang-release",
            "configurePreset": "linux-clang-release"
        },
        {
            "name": "windows-msvc",
            "configurePreset": "windows-msvc",
            "configuration": "Debug"
        },
        {
            "name": "windows-msvc-release",
            "configurePreset": "windows-msvc-release",
            "configuration": "Release"
        },
        {
            "name": "windows-vs2026",
            "configurePreset": "windows-vs2026",
            "configuration": "Debug",
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Windows"
            }
        },
        {
            "name": "windows-vs2026-release",
            "configurePreset": "windows-vs2026-release",
            "configuration": "Release",
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Windows"
            }
        },
        {
            "name": "android-arm64-v8a",
            "configurePreset": "android-arm64-v8a"
        },
        {
            "name": "android-armeabi-v7a",
            "configurePreset": "android-armeabi-v7a"
        },
        {
            "name": "android-x86_64",
            "configurePreset": "android-x86_64"
        }
    ],
    "testPresets": [
        {
            "name": "linux-clang",
            "configurePreset": "linux-clang",
            "output": {
                "outputOnFailure": true
            }
        },
        {
            "name": "linux-clang-release",
            "configurePreset": "linux-clang-release",
            "output": {
                "outputOnFailure": true
            }
        },
        {
            "name": "windows-msvc",
            "configurePreset": "windows-msvc",
            "configuration": "Debug",
            "output": {
                "outputOnFailure": true
            }
        },
        {
            "name": "windows-msvc-release",
            "configurePreset": "windows-msvc-release",
            "configuration": "Release",
            "output": {
                "outputOnFailure": true
            }
        },
        {
            "name": "windows-vs2026",
            "configurePreset": "windows-vs2026",
            "configuration": "Debug",
            "output": {
                "outputOnFailure": true
            },
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Windows"
            }
        },
        {
            "name": "windows-vs2026-release",
            "configurePreset": "windows-vs2026-release",
            "configuration": "Release",
            "output": {
                "outputOnFailure": true
            },
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Windows"
            }
        }
    ]
}
